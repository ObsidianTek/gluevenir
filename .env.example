# Non-secret Compose configuration only. Copy to .env and fill as needed.
# Secret values belong in ignored .private/compose files, never in this file.
GLUEVENIR_AWS_REGION=us-east-1
GLUEVENIR_BEDROCK_GUARDRAIL_ID=
GLUEVENIR_BEDROCK_GUARDRAIL_VERSION=2

# These are file paths, not secret values.
GLUEVENIR_BEDROCK_TOKEN_FILE=.private/compose/bedrock_api_key
GLUEVENIR_COCKROACH_URL_FILE=.private/compose/cockroach_runtime_url

# Existing public endpoints used only by compose.cloud.yaml's local viewer.
GLUEVENIR_CLOUD_API_URL=
GLUEVENIR_CLOUD_SITE_URL=
