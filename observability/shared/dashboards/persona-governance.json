      "targets": [{"editorMode": "code", "expr": "sum(traces_span_metrics_calls_total{span_name=\"gluevenir.gateway.evaluation\",gluevenir_persona=~\"$persona\"})", "instant": true, "legendFormat": "governed turns", "range": false, "refId": "A"}],
